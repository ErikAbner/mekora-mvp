# O storage tem mais de um gigabyte e não é código: ele entra por volume, para
# viver mais que a imagem. Copiá-lo aqui incharia toda construção e ainda faria
# a imagem carregar documentos pessoais.
storage/
.venv/
venv/
node_modules/
**/node_modules/
**/dist/
.git/
# Os segredos entram por ambiente, no servidor. Dentro da imagem eles ficariam
# legíveis em qualquer camada, para sempre — inclusive depois de trocados.
.env
.env.*
!.env.example
*.db
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
scratchpad/
legado/
plugin/
docs/
