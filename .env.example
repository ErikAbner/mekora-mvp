# ---------------------------------------------------------------------------
# PRODUÇÃO — o que muda quando o Mekora sai desta máquina
# ---------------------------------------------------------------------------

# O domínio que a borda serve. Com ele definido, o Caddy pede o certificado TLS
# sozinho e renova sozinho. Sem ele, sobe em localhost com certificado próprio —
# que é o que se quer para provar a pilha antes de apontar o DNS.
MEKORA_DOMINIO=mekora.com.br

# Só é necessário quando interface e API rodam em endereços diferentes.
# No desenvolvimento local o padrão já é http://127.0.0.1:5180.
# MEKORA_FRONTEND_URL=https://app.mekora.com.br

# Onde ficam os documentos e o banco. Uma variável decide tudo: entrada, saída,
# miniaturas, modelos e o SQLite. Dentro do container o Dockerfile já a define
# como /app/storage, que é o volume.
#
# Fora do container o padrão é a pasta `storage/` do projeto, e quem não
# configura nada não vê diferença. Vale apontá-la para outro lugar ao rodar um
# servidor de prova: sem isso, um teste com banco isolado ainda grava arquivos
# no storage de verdade.
# MEKORA_STORAGE=/app/storage
# DATABASE_URL=sqlite:////app/storage/kindle_tool.db

# Em produção a interface e a API ficam no MESMO domínio, atrás da mesma borda.
# Mesma origem significa que não há CORS para configurar — e nenhum cabeçalho
# permissivo esquecido aberto, que é como isso costuma dar errado.
ALLOWED_ORIGINS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_google
KINDLE_EMAIL=seu_kindle@kindle.com

# Pacotes locais do Argos Translate (relativo à raiz do projeto)
# Execute: argospm install translate-pt_en translate-pt_es translate-en_pt translate-es_pt
ARGOS_PACKAGES_DIR=./storage/models/argos-packages

# ---------------------------------------------------------------------------
# v1.2.2 — Limites de processamento local (opcional; defaults funcionam)
# Todos aceitam apenas valores > 0. Zeros/negativos abortam o startup.
# ---------------------------------------------------------------------------

# Upload
# Tamanho máximo por upload em MB (default 600 MB)
KLT_UPLOAD_MAX_MB=600
# Tamanho do chunk usado no streaming (default 1 MB); mínimo 4096 bytes
KLT_UPLOAD_CHUNK_BYTES=1048576

# Arquivos compactados (CBZ/CBR/CB7/CBC)
# Quantidade máxima de entradas dentro do arquivo (default 5.000)
KLT_ARCHIVE_MAX_ENTRIES=5000
# Soma máxima descomprimida em MB (default 2 GB)
KLT_ARCHIVE_MAX_TOTAL_MB=2048
# Tamanho máximo de uma única entrada em MB (default 200 MB); <= TOTAL_MB
KLT_ARCHIVE_MAX_ENTRY_MB=200

# Páginas e imagens
# Quantidade máxima de páginas processadas por job (default 3.000)
KLT_MAX_PAGES=3000
# Total máximo de pixels por imagem (default 100.000.000 = 100 MP).
# Cobre A4 @ 600 DPI (~35 MP) e Tabloide @ 600 DPI (~72 MP) com folga.
# A checagem é EXATA: (width × height > KLT_IMAGE_MAX_PIXELS) é rejeitado
# antes de decodificar a imagem — não depende do warning do Pillow.
# Usuários com scans legítimos excepcionalmente grandes podem elevar este
# limite conscientemente (cada +100 MP ≈ +400 MB de RAM por imagem RGBA).
KLT_IMAGE_MAX_PIXELS=100000000

# Timeouts de ferramentas externas (segundos)
# Calibre/ebook-convert (default 600 s = 10 min)
KLT_CALIBRE_TIMEOUT_SECONDS=600
# KCC/kcc-c2e (default 900 s = 15 min; capas + otimização de imagem)
KLT_KCC_TIMEOUT_SECONDS=900
# Limite de bytes capturados de stdout/stderr por chamada (default 8 KB)
KLT_SUBPROCESS_OUTPUT_MAX_BYTES=8192
# OCRmyPDF: cooperativo (não é subprocess controlado); ver docs
KLT_OCR_SOFT_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------------------
# QUEM MANDA NA INSTALAÇÃO
# ---------------------------------------------------------------------------

# `/config`, `/app-config` e `/presets` falam da instalação inteira: o endereço
# de onde os documentos saem, quanto tempo o arquivo de todo mundo vive, e o
# gatilho da limpeza. Elas exigem SER DONO, e não só ter conta — a entrada é por
# link no e-mail, então "tem conta" é qualquer pessoa da internet.
#
# Aceita mais de um, separados por vírgula.
#
# SEM ESTA LINHA NINGUÉM É DONO e as três respondem 403 para todo mundo,
# inclusive para você. É de propósito: o contrário seria "esqueci de configurar,
# então está aberto".
DONO_EMAIL=
