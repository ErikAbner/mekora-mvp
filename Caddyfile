# A borda do Mekora. Ela serve a interface, entrega o TLS e é o único ponto que
# fala com a internet.
#
# O DOMÍNIO VEM DO AMBIENTE, e não escrito aqui: o mesmo arquivo tem de servir
# para o servidor de verdade e para uma prova local, e um domínio cravado
# obrigaria a editar arquivo a cada uma — que é como se sobe a configuração
# errada.
#
# O bloco de rotas abaixo é GERADO a partir do próprio FastAPI, por
# `scripts/rotas.py`. Ele não é escrito à mão porque já foi, em dois lugares —
# aqui e no proxy do `vite.config.js` — e duas listas da mesma coisa divergem no
# dia em que alguém cria uma rota e só atualiza uma delas.
{$MEKORA_DOMINIO:localhost} {
	encode gzip zstd

	# ── rotas do backend ── GERADO por scripts/rotas.py, não editar à mão
	handle /analyze/* /aparelhos/* /app-config/* /batch/* /canvas/* /config/* /entrar/* /estudos/* /eu/* /jobs/* /metrics/* /notas/* /pending-send/* /presets/* /privacidade/* /sessoes/* /storage/* /tools/* /translation/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /aparelhos /app-config /buscar /config /eu /health /history /preferencias /presets /privacidade /recados /sair /sessoes /upload {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# ── fim das rotas geradas ──

	handle {
		root * /srv
		# O roteador vive no navegador: recarregar /leitura/1 tem de devolver o
		# index, e não um 404 do servidor de arquivos.
		try_files {path} /index.html
		file_server
	}

	header {
		# Sem esta linha o navegador pode adivinhar o tipo de um arquivo pelo
		# conteúdo, e um documento enviado por alguém pode ser adivinhado como
		# HTML — que é execução de código de estranho no domínio do produto.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ── QUANTO TEMPO O NAVEGADOR PODE GUARDAR ──
	#
	# Sem isto o Caddy manda `Etag` e nada mais: o navegador volta a perguntar
	# por CADA arquivo em cada visita, recebe 304, e paga a ida à rede assim
	# mesmo. Numa página com trinta ícones isso é trinta idas para não baixar
	# nada.
	#
	# O que pode ser guardado para sempre é o que tem o CONTEÚDO NO NOME:
	# `index-Byykk_Fg.js` só existe com aquele conteúdo, e uma versão nova é
	# outro nome. Guardar por um ano não deixa ninguém preso em versão velha —
	# `immutable` diz ao navegador que nem vale a pena perguntar.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# A fonte não tem hash no nome, mas também nunca muda: se a Zodiak for
	# trocada um dia, o arquivo novo entra com outro nome (é o que `ORIGEM`
	# pede em `docs/FONTES.md`).
	header /fontes/* Cache-Control "public, max-age=31536000, immutable"

	# Ícone e capa NÃO levam hash e PODEM ser reexportados do Figma com o mesmo
	# nome. Um ano aqui prenderia todo mundo no desenho velho até 2027. Um dia,
	# e uma semana servindo o antigo enquanto busca o novo por trás.
	header /icones/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	header /capas/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# O `index.html` é o mapa: é ele que diz quais nomes de arquivo existem
	# agora. Guardá-lo faria o navegador pedir pacotes que a subida anterior
	# apagou — a tela em branco clássica do dia seguinte ao deploy.
	header /index.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"
}
